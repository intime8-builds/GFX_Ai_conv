{
  "name": "gfx-ai-conv-simple-preview",
  "version": "0.3.0-alpha.1",
  "description": "Автономная локальная конвертация EXR, MOV и MP4 для AI и Nuke.",
  "main": "src/simple/main.js",
  "author": "intime8",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "backend:prepare": "python scripts/prepare-simple.py",
    "test:backend": "python -m unittest discover -s backend/simple -p test_*.py -v",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:zip": "electron-builder --win zip"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "npm:@derhuerst/ffprobe-static@5.3.0",
    "lucide": "1.55.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.intime8.gfxaiconv.simple.preview",
    "productName": "GFX Ai Conv Simple Preview",
    "copyright": "Copyright © 2026 intime8",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "src/simple/**/*",
      "src/core/logger.js",
      "src/core/update.js",
      "THIRD_PARTY_NOTICES.md",
      "README_SIMPLE.md",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/simple-runtime/gfx-worker",
        "to": "simple-runtime/gfx-worker"
      },
      {
        "from": "resources/simple-runtime/licenses",
        "to": "licenses"
      },
      {
        "from": "resources/aces_1.2",
        "to": "aces_1.2",
        "filter": [
          "config.ocio",
          "luts/**/*",
          "README.md",
          "bundle.json",
          "LICENSE*"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist-simple"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-installer-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
