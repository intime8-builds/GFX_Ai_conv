{
  "name": "gfx_ai_conv",
  "version": "0.2.0-alpha.4",
  "description": "Локальная подготовка AI-конформа: denoise, 3DE undistort, Rec.709 ProRes 4444 и Topview.",
  "main": "src/main.js",
  "author": "intime8",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:zip": "electron-builder --win zip"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^37.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.intime8.gfxaiconv",
    "productName": "GFX Ai Conv",
    "copyright": "Copyright © 2026 intime8",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "backend/**",
      "vendor/**"
    ],
    "files": [
      "src/**/*",
      "backend/**/*",
      "vendor/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-installer-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
